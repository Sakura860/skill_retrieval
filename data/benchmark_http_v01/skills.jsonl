{"brief_description": "从指定 API 路径读取 JSON 资源。", "category": "http_read", "dependencies": [], "detailed_description": "发起一次 GET。默认仅接受 200/201/202/204；若任务限定成功状态，传 accepted_statuses。若未接受状态必须原样返回且不自动重试，传 on_unaccepted=return_body；否则抛出错误。", "examples": ["严格状态失败时：{\"path\":\"/limits\",\"accepted_statuses\":[200],\"on_unaccepted\":\"return_body\"}"], "id": "shttp01", "metadata": {"permission": "http:read"}, "name": "http_get_json", "parameters": {"additionalProperties": false, "properties": {"accepted_statuses": {"items": {"maximum": 599, "minimum": 100, "type": "integer"}, "minItems": 1, "type": "array"}, "on_unaccepted": {"enum": ["raise", "return_body"], "type": "string"}, "path": {"pattern": "^/", "type": "string"}}, "required": ["path"], "type": "object"}, "returns": {"description": "JSON 或原始响应正文", "type": "string"}, "tags": ["HTTP", "GET", "JSON", "API"]}
{"brief_description": "从指定 API 路径读取纯文本正文。", "category": "http_read", "dependencies": [], "detailed_description": "发起一次 GET 并返回文本；适用于非 JSON 内容。", "examples": [], "id": "shttp02", "metadata": {"permission": "http:read"}, "name": "http_get_text", "parameters": {"additionalProperties": false, "properties": {"accepted_statuses": {"items": {"maximum": 599, "minimum": 100, "type": "integer"}, "minItems": 1, "type": "array"}, "path": {"pattern": "^/", "type": "string"}}, "required": ["path"], "type": "object"}, "returns": {"type": "string"}, "tags": ["HTTP", "GET", "text"]}
{"brief_description": "用 HEAD 检查 API 路径并返回状态码。", "category": "http_read", "dependencies": [], "detailed_description": "只发起一次 HEAD，不下载响应正文，返回整数状态码。", "examples": [], "id": "shttp03", "metadata": {"permission": "http:read"}, "name": "http_head_status", "parameters": {"additionalProperties": false, "properties": {"path": {"pattern": "^/", "type": "string"}}, "required": ["path"], "type": "object"}, "returns": {"maximum": 599, "minimum": 100, "type": "integer"}, "tags": ["HTTP", "HEAD", "status", "health"]}
{"brief_description": "为给定 scope 从本地认证端点签发访问令牌。", "category": "http_auth", "dependencies": [], "detailed_description": "POST /oauth/token，并从 JSON 响应中只返回 access_token 字符串。", "examples": [], "id": "shttp04", "metadata": {"permission": "http:auth"}, "name": "http_issue_token", "parameters": {"additionalProperties": false, "properties": {"scope": {"type": "string"}}, "required": ["scope"], "type": "object"}, "returns": {"description": "Bearer token", "type": "string"}, "tags": ["HTTP", "OAuth", "token", "authentication"]}
{"brief_description": "携带 Bearer token 读取受保护 JSON API。", "category": "http_auth", "dependencies": ["shttp04"], "detailed_description": "使用 Authorization: Bearer <token> 发起一次 GET 并返回 JSON。", "examples": ["token 可使用上一步输出：{\"path\":\"/reports/daily\",\"token\":\"$last_output\"}"], "id": "shttp05", "metadata": {"depends_on": ["shttp04"], "permission": "http:auth"}, "name": "http_get_bearer_json", "parameters": {"additionalProperties": false, "properties": {"path": {"pattern": "^/", "type": "string"}, "token": {"type": "string"}}, "required": ["path", "token"], "type": "object"}, "returns": {"description": "JSON 响应", "type": "string"}, "tags": ["HTTP", "GET", "Bearer", "protected"]}
{"brief_description": "带幂等键向 API 路径提交 JSON。", "category": "http_write", "dependencies": [], "detailed_description": "只发起一次 POST。默认接受 200/201/202/204，成功时返回包含 status 与 data 的包装 JSON。若任务说仅当特定状态成功，应传 accepted_statuses；若未接受状态要求原样返回且不自动重试，同时传 on_unaccepted=return_body，此时直接返回服务正文，不加包装。", "examples": ["仅接受 201：{\"accepted_statuses\":[201],\"on_unaccepted\":\"return_body\"}"], "id": "shttp06", "metadata": {"permission": "http:write"}, "name": "http_post_json", "parameters": {"additionalProperties": false, "properties": {"accepted_statuses": {"items": {"maximum": 599, "minimum": 100, "type": "integer"}, "minItems": 1, "type": "array"}, "idempotency_key": {"minLength": 1, "type": "string"}, "on_unaccepted": {"enum": ["raise", "return_body"], "type": "string"}, "path": {"pattern": "^/", "type": "string"}, "payload": {"type": "object"}}, "required": ["path", "payload", "idempotency_key"], "type": "object"}, "returns": {"type": "string"}, "tags": ["HTTP", "POST", "JSON", "idempotency"]}
{"brief_description": "通过 PUT 将完整 JSON 表示写入指定 API 路径。", "category": "http_write", "dependencies": [], "detailed_description": "发起一次 PUT；用于完整替换资源，不用于局部字段更新。", "examples": [], "id": "shttp07", "metadata": {"permission": "http:write"}, "name": "http_put_json", "parameters": {"additionalProperties": false, "properties": {"path": {"pattern": "^/", "type": "string"}, "payload": {"type": "object"}}, "required": ["path", "payload"], "type": "object"}, "returns": {"description": "JSON 响应", "type": "string"}, "tags": ["HTTP", "PUT", "replace", "JSON"]}
{"brief_description": "通过 PATCH 对 API 资源做 JSON 局部更新。", "category": "http_write", "dependencies": [], "detailed_description": "发起一次 PATCH；只发送待变更字段，不替换未提供字段。", "examples": [], "id": "shttp08", "metadata": {"permission": "http:write"}, "name": "http_patch_json", "parameters": {"additionalProperties": false, "properties": {"patch": {"type": "object"}, "path": {"pattern": "^/", "type": "string"}}, "required": ["path", "patch"], "type": "object"}, "returns": {"description": "JSON 响应", "type": "string"}, "tags": ["HTTP", "PATCH", "partial update", "JSON"]}
{"brief_description": "通过 DELETE 删除指定 API 资源并返回状态码。", "category": "http_write", "dependencies": [], "detailed_description": "发起一次 DELETE；只接受 200/202/204，返回服务状态码。", "examples": [], "id": "shttp09", "metadata": {"permission": "http:write"}, "name": "http_delete_resource", "parameters": {"additionalProperties": false, "properties": {"path": {"pattern": "^/", "type": "string"}}, "required": ["path"], "type": "object"}, "returns": {"type": "integer"}, "tags": ["HTTP", "DELETE", "resource"]}
